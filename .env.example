# ── Base ──────────────────────────────────────────────────────────────
PORT=3000

# ── Google Gemini (LLM) ───────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.6-flash

# ── LLM alternativo (OpenRouter / OpenAI-compatível) ─────────────────
# Usa-se se LLM_PROVIDER=openrouter. Requer LLM_API_KEY (e opcionalmente LLM_BASE_URL).
# LLM_PRIMARY define a ordem de failover (gemini | openrouter); o outro
# entra automaticamente se o primeiro falhar (quota/erro).
LLM_PROVIDER=openrouter
LLM_PRIMARY=gemini
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# ── Autenticação (tokens) ─────────────────────────────────────────────
AUTH_SECRET=troque-por-um-segredo-longo-aleatorio
AUTH_TOKEN_HORAS=12

# ── BDs de cada sistema (Neon) ────────────────────────────────────────
FARMACIA_DATABASE_URL=
XONGUILE_DATABASE_URL=
CAFEPOINT_DATABASE_URL=
ARMAZEM_DATABASE_URL=
GYMAR_DATABASE_URL=
DDGEI_DATABASE_URL=
CREDHUB_DATABASE_URL=
ADEGAHUB_DATABASE_URL=
MACHAMBA_DATABASE_URL=
SMARTSCHOOL_DATABASE_URL=
BROKERHUB_DATABASE_URL=
ENTREGAS_DATABASE_URL=
